{
  "name": "craft-vscode",
  "displayName": "Craft Apps",
  "description": "Open the craft apps (PhotoCraft, VectorCraft, LightCraft, FilmCraft, EffectCraft) from a craft-ai-hub in editor panels, and let Claude Code, Codex, Gemini CLI or VS Code chat drive them over one local MCP server.",
  "version": "0.3.0",
  "publisher": "hayone1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hayone1/craft-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "claude",
    "codex",
    "gemini",
    "craft",
    "photocraft",
    "code-server"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:craft.app"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "craft",
          "title": "Craft Apps",
          "icon": "media/craft.svg"
        }
      ]
    },
    "views": {
      "craft": [
        {
          "id": "craft.apps",
          "name": "Apps"
        }
      ]
    },
    "commands": [
      {
        "command": "craft.open",
        "title": "Open App",
        "category": "Craft",
        "icon": "$(add)"
      },
      {
        "command": "craft.reload",
        "title": "Reload App",
        "category": "Craft",
        "icon": "$(refresh)"
      },
      {
        "command": "craft.signIn",
        "title": "Sign In to the Hub",
        "category": "Craft"
      },
      {
        "command": "craft.copyMcpUrl",
        "title": "Copy MCP Server URL",
        "category": "Craft"
      },
      {
        "command": "craft.copyMcpToken",
        "title": "Copy MCP Server Token",
        "category": "Craft"
      },
      {
        "command": "craft.newMcpToken",
        "title": "Make a New MCP Server Token",
        "category": "Craft"
      },
      {
        "command": "craft.setMcpUrl",
        "title": "Set an App's MCP URL by Hand",
        "category": "Craft"
      },
      {
        "command": "craft.registerAgents",
        "title": "Add the MCP Server to Coding Agents",
        "category": "Craft"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "craft.open",
          "when": "view == craft.apps",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "craft.reload",
          "when": "activeWebviewPanelId == craft.app",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Craft Apps",
      "properties": {
        "craft.hubUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "The craft-ai-hub address, e.g. `https://craft.example.com`. Empty: the `CRAFT_HUB_URL` environment variable."
        },
        "craft.apps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The hub's apps, in order. Empty: `CRAFT_APPS` (comma separated), else PhotoCraft, VectorCraft, LightCraft, FilmCraft and EffectCraft."
        },
        "craft.mcpPort": {
          "type": "number",
          "default": 47811,
          "description": "The local port of the MCP server (http://127.0.0.1:<port>/mcp)."
        },
        "craft.agents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "gemini"
            ],
            "enumDescriptions": [
              "Claude Code (~/.claude.json, through the claude CLI)",
              "Codex (~/.codex/config.toml; the Codex CLI and the Codex extension)",
              "Gemini CLI (~/.gemini/settings.json)"
            ]
          },
          "uniqueItems": true,
          "default": [
            "claude",
            "codex",
            "gemini"
          ],
          "markdownDescription": "The coding agents that get the `craft` MCP server (URL and token) in their user settings. An agent installed later is set up within 5 minutes, or at once with **Craft: Add the MCP Server to Coding Agents**. Remove an agent to leave its settings alone."
        },
        "craft.registerWithClaudeCode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Deprecated: use `craft.agents`. `false` leaves Claude Code alone.",
          "markdownDeprecationMessage": "Use `craft.agents` (remove `claude` from it)."
        },
        "craft.workspaceFiles": {
          "type": [
            "string",
            "boolean"
          ],
          "enum": [
            "readWrite",
            "readOnly",
            "off",
            true,
            false
          ],
          "enumDescriptions": [
            "The apps can open files from the workspace folders and save files into them.",
            "The apps can open files from the workspace folders, but not save into them.",
            "The apps get no access to the workspace.",
            "The same as readWrite.",
            "The same as off."
          ],
          "default": "readWrite",
          "markdownDescription": "What the app panels may do with the workspace folders: list them in the apps' **File › Open** and **Save** dialogs, and open files dragged from the explorer (hold Shift). Hidden files and folders (`.git`, `.vscode`, `.env`) stay off limits, and `node_modules` is never written. A change takes effect at once in every open panel."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "craft.mcp",
        "label": "Craft apps"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.mjs --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build -- --minify && vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1c1c1c",
    "theme": "dark"
  },
  "homepage": "https://github.com/hayone1/craft-vscode#readme",
  "bugs": {
    "url": "https://github.com/hayone1/craft-vscode/issues"
  },
  "pricing": "Free"
}
